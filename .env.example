# Model access: any OpenAI-compatible endpoint. The course route is Nebius Token Factory
# (you join the TripleTen organization by invitation and create your own key). Examples:
#   Nebius:     LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/   LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=anthropic/claude-haiku-4.5
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1                 LLM_MODEL=gpt-4.1-mini
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/             LLM_MODEL=claude-haiku-4-5
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1                 LLM_MODEL=qwen3:8b   (experimental)
# Run `python scripts/check_provider.py` after filling these in: it checks tool calling and JSON output.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_MODEL_REVIEW=openai/gpt-oss-120b

# Tracing (free tier at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolve

# Local services (defaults match compose.yaml)
OPENSEARCH_URL=http://localhost:9200
HELPDESK_URL=http://localhost:8100
HELPDESK_PORT=8100
